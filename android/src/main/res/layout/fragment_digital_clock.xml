<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#667eea">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/clock_title"
            android:textSize="24sp"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_toggle_format"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24H"
            android:textColor="@android:color/white"
            android:background="#764ba2"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_toggle_language"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tiếng Việt"
            android:textColor="@android:color/white"
            android:background="#764ba2" />
    </LinearLayout>

    <!-- Clocks Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/clocks_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>

    <!-- Add Button -->
    <Button
        android:id="@+id/btn_add_clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/clock_add_timezone"
        android:textColor="@android:color/white"
        android:background="#4ecdc4"
        android:padding="16dp"
        android:textStyle="bold"
        android:textSize="16sp" />
</LinearLayout>
